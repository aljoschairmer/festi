# Copy to .env.local and fill in. Never commit real secrets.

# Database
# What the app queries through. On Neon this is the POOLED endpoint.
DATABASE_URL="postgresql://postgres:changeme@localhost:5432/database"

# What migrations, introspection and the seed run against. On Neon this is
# the DIRECT endpoint: PgBouncer cannot hold the locks the schema engine
# needs. Falls back to DATABASE_URL when unset.
DIRECT_URL=""

# Optional. Shadow database for `prisma migrate dev`. On Neon, a second
# branch or database.
SHADOW_DATABASE_URL=""

# Optional. "neon" or "postgres". Only needed when the host does not say —
# e.g. a Neon proxy running under your own hostname.
DATABASE_DRIVER=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Festi <onboarding@resend.dev>"

# Maps and routing
NEXT_PUBLIC_MAPTILER_API_KEY=""
BROUTER_URL=""
ROUTE_ENGINE_URL=""
ROUTE_ENGINE_API_KEY=""

# Media storage (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Cron
# Shared secret the Worker's scheduled handler sends to /api/pro/capture.
CRON_SECRET=""
