// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  username      String?       @unique
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          String?       @default("user")
  banned        Boolean?      @default(false)
  banReason     String?
  banExpires    DateTime?
  lastSeenAt    DateTime?
  bio          String?
  location     String?
  bikeBrand    String?
  bikeModel    String?
  skillLevel   String?
  ridingStyles String[]  @default([])
  yearsRiding  Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      Session[]
  accounts      Account[]
  groups        GroupMember[]
  groupMessages GroupMessage[]
  sentMessages     DirectMessage[] @relation("SentDirectMessages")
  receivedMessages DirectMessage[] @relation("ReceivedDirectMessages")
  notifications          Notification[] @relation("UserNotifications")
  triggeredNotifications Notification[] @relation("NotificationActor")
  followers     Follow[]      @relation("Following")
  following     Follow[]      @relation("Follower")

  createdGroups Group[] @relation("GroupCreator")

  activityLogs    ActivityLog[] @relation("ActivityActor")
  targetedByLogs  ActivityLog[] @relation("ActivityTargetUser")

  rides              Ride[]            @relation("RideCreator")
  rideParticipations RideParticipant[]
  routes             Route[]           @relation("RouteCreator")
  announcements      GroupAnnouncement[] @relation("AnnouncementAuthor")

  posts Post[] @relation("PostAuthor")
  postLikes    PostLike[]
  postComments PostComment[]

  @@index([banned, createdAt])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Group {
  id           String  @id @default(cuid())
  name         String
  description  String
  createdById  String
  needApproval Boolean @default(false)

  image     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   GroupMember[]
  messages GroupMessage[]
  rides     Ride[]        @relation("GroupRides")
  routes    Route[]       @relation("GroupRoutes")
  announcements GroupAnnouncement[] @relation("GroupAnnouncements")

  createdBy User @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("group")
}

enum GroupMemberStatus {
  PENDING
  APPROVED
}

model GroupMember {
  id        String            @id @default(cuid())
  userId    String
  groupId   String
  role      String            @default("member")
  status    GroupMemberStatus @default(APPROVED)
  createdAt DateTime          @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@index([groupId, status])
  @@index([userId, status])
  @@map("group_member")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model GroupMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId])
  @@index([groupId, createdAt])
  @@map("group_message")
}

model DirectMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  readAt    DateTime?

  senderId String
  sender   User   @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("ReceivedDirectMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([senderId, recipientId])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@index([recipientId, readAt])
  @@map("direct_message")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  read      Boolean          @default(false)
  message   String?
  createdAt DateTime         @default(now())

  // Who receives the notification.
  userId String
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // Who triggered it (optional, e.g. the follower).
  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  // Polymorphic reference to any related entity (e.g. a group).
  targetType String?
  targetId   String?

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt, id])
  @@index([userId, type, targetId])
  @@map("notification")
}

enum NotificationType {
  USER_FOLLOWED
  GROUP_JOINED
  GROUP_JOIN_REQUESTED
  GROUP_JOIN_APPROVED
  GROUP_JOIN_REJECTED
  GROUP_RIDE_CREATED
  GROUP_ANNOUNCEMENT
  RIDE_JOIN_REQUEST
  RIDE_JOIN_APPROVED
  RIDE_JOIN_REJECTED
  RIDE_UPDATED
  RIDE_CANCELLED
  RIDE_WAITLIST_PROMOTED
  POST_LIKED
  POST_COMMENTED
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followingId String
  createdAt  DateTime @default(now())

  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following  User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follow")
}

enum ActivityAction {
  USER_REGISTERED
  USER_REGISTRATION_FAILED
  USER_LOGGED_IN
  USER_LOGIN_FAILED
  USER_LOGGED_OUT
  USER_EMAIL_VERIFIED
  USER_UPDATED_PROFILE
  USER_CHANGED_PASSWORD
  USER_BANNED
  USER_UNBANNED
  USER_ROLE_CHANGED
  USER_FOLLOWED
  USER_UNFOLLOWED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  GROUP_JOINED
  GROUP_LEFT
  GROUP_MEMBER_APPROVED
  GROUP_MEMBER_REMOVED
  GROUP_MESSAGE_SENT
  DIRECT_MESSAGE_SENT
  RIDE_CREATED
  RIDE_UPDATED
  RIDE_CANCELLED
  RIDE_JOIN_REQUESTED
  RIDE_JOIN_APPROVED
  RIDE_JOIN_REJECTED
  RIDE_JOIN_WITHDRAWN
  RIDE_LEFT
  RIDE_WAITLISTED
  RIDE_WAITLIST_PROMOTED
  RIDE_ATTENDANCE_MARKED
  GROUP_JOIN_REQUESTED
  GROUP_MEMBER_REJECTED
  GROUP_MEMBER_ROLE_CHANGED
  GROUP_ANNOUNCEMENT_CREATED
  ROUTE_SAVED
  ROUTE_DELETED
  POST_CREATED
  POST_LIKED
  POST_COMMENTED
  OTHER
}

model ActivityLog {
  id     String         @id @default(cuid())
  action ActivityAction

  // The user who performed the action. Nullable for system/anonymous events.
  actorId String?
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  // Optional user that the action targets (e.g. the followed user).
  targetUserId String?
  targetUser   User?   @relation("ActivityTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  // Polymorphic reference to any other entity involved (e.g. "group", "message").
  targetType String?
  targetId   String?

  // Human-readable summary, e.g. "User X followed User Y".
  description String?

  // Arbitrary structured payload for extra analytics context.
  metadata Json?

  // Request/session context captured at log time.
  ipAddress String?
  userAgent String?
  sessionId String?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([targetUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("activity_log")
}

enum RideParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  WAITLISTED
}

enum RideStatus {
  SCHEDULED
  CANCELLED
}

model Ride {
  id            String   @id @default(cuid())
  creatorId     String
  title         String
  description   String?
  startLocation String?
  startTime     DateTime
  distance      Float
  duration      Int
  elevationGain Int      @default(0)
  elevationLoss Int      @default(0)
  routeGeometry String
  waypoints     Json
  elevationProfile Json?
  status        RideStatus @default(SCHEDULED)
  maxParticipants Int?
  pace          String?
  difficulty    String?
  groupId       String?
  recurrenceId  String?
  startLat      Float?
  startLng      Float?
  /// Opt-in. The public page exposes start location, time and the
  /// organiser's name to anyone with the link, so it must be a choice.
  isPublic      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator      User              @relation("RideCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  group        Group?            @relation("GroupRides", fields: [groupId], references: [id], onDelete: SetNull)
  participants RideParticipant[]
  photos       RidePhoto[]

  @@index([creatorId])
  @@index([startTime])
  @@index([status, startTime])
  @@index([groupId])
  @@index([recurrenceId])
  @@index([creatorId, createdAt, id])
  @@index([groupId, status, startTime])
  @@index([startLat, startLng])
  @@map("ride")
}

model RidePhoto {
  id        String   @id @default(cuid())
  rideId    String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@map("ride_photo")
}

model Route {
  id            String   @id @default(cuid())
  creatorId     String
  groupId       String?
  name          String
  description   String?
  distance      Float
  duration      Int
  elevationGain Int      @default(0)
  elevationLoss Int      @default(0)
  routeGeometry String
  waypoints     Json
  elevationProfile Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator User   @relation("RouteCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  group   Group? @relation("GroupRoutes", fields: [groupId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([groupId])
  @@map("route")
}

model GroupAnnouncement {
  id        String   @id @default(cuid())
  groupId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  group  Group @relation("GroupAnnouncements", fields: [groupId], references: [id], onDelete: Cascade)
  author User  @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([groupId, createdAt])
  @@map("group_announcement")
}

model RideParticipant {
  id        String                @id @default(cuid())
  rideId    String
  userId    String
  status    RideParticipantStatus @default(PENDING)
  attended  Boolean?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rideId, userId])
  @@index([rideId])
  @@index([userId])
  @@index([rideId, status, createdAt])
  @@map("ride_participant")
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  images PostImage[]
  likes    PostLike[]
  comments PostComment[]

  @@index([authorId])
  @@index([createdAt])
  @@index([authorId, createdAt, id])
  @@map("post")
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@map("post_like")
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
  @@map("post_comment")
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@unique([postId, position])
  @@map("post_image")
}

// Cached copy of the rad-net.de (BDR) Breitensportkalender, scraped via the
// radnet-breitensport package. List rows are upserted by the calendar sync;
// detail fields (coordinates, start location, …) are filled in lazily in
// small polite batches, so `lat`/`lng` stay null until the detail pass ran.
model RadnetEvent {
  id            String  @id
  type          String
  date          DateTime
  title         String
  distances     Int[]
  club          String?
  lvAbbr        String?
  detailUrl     String
  struckThrough Boolean @default(false)

  // Detail-page fields (null until detailSyncedAt is set).
  landesverband String?
  startZip      String?
  startCity     String?
  startVenue    String?
  startTime     String?
  website       String?
  lat           Float?
  lng           Float?
  cancelled     Boolean @default(false)
  cancelReason  String?

  detailSyncedAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([date])
  @@index([detailSyncedAt])
  @@index([detailSyncedAt, date])
  @@map("radnet_event")
}

// One captured live-telemetry snapshot for a pro race stage. Rows are written
// by the cron-driven /api/pro/capture endpoint during live racing (the
// upstream only ever serves the current frame) and read back by the stage
// replay UI. `capturedAt` carries the upstream's `_updatedAt`, so the unique
// constraint dedupes unchanged frames.
model ProTelemetryFrame {
  id         String   @id @default(cuid())
  raceKey    String
  year       Int
  stage      Int
  capturedAt DateTime
  payload    Json
  createdAt  DateTime @default(now())

  @@unique([raceKey, year, stage, capturedAt])
  @@index([raceKey, year, stage])
  @@map("pro_telemetry_frame")
}

// Singleton row (id = 1) tracking calendar sync freshness and acting as a
// lock so concurrent visitors don't scrape rad-net in parallel.
model RadnetSyncState {
  id           Int       @id @default(1)
  listSyncedAt DateTime?
  lockedUntil  DateTime?

  @@map("radnet_sync_state")
}

/// Fixed-window counters for public, unauthenticated server actions.
/// better-auth's own limiter only covers its router; actions that call
/// `auth.api.*` directly (registration) bypass it entirely.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit")
}
